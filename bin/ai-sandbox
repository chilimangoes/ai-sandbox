#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
IMAGE_TAG="ai-sandbox:latest"
DEFAULT_T3_CONTAINER_PORT=3773
DEFAULT_CODENOMAD_CONTAINER_PORT=9899
DEFAULT_PASEO_CONTAINER_PORT=6767
DEFAULT_ALT_HTTP_CONTAINER_PORT=8080
DEFAULT_APP_CONTAINER_PORT=3000

usage() {
  echo "Usage: ai-sandbox [--engine auto|docker|podman] [--update] [--rebuild] [--add-folder <path> [--as <name>] [--global|--local] [--read-only|--read-write] [--yes]] [shell|codex|claude|agy|copilot|opencode|cursor|cursor-agent|t3|codenomad|paseo|doctor|stop|rm|reset-config|reset-state]"
}

engine() {
  "$ENGINE_COMMAND" "$@"
}

normalize_container_name() {
  printf '%s\n' "${1#/}"
}

engine_healthy() {
  local name="$1"
  command -v "$name" >/dev/null 2>&1 && "$name" version >/dev/null 2>&1
}

resolve_engine() {
  local requested="$1" candidate
  case "$requested" in
    auto|docker|podman) ;;
    *) echo "Invalid engine '$requested'. Expected auto, docker, or podman." >&2; return 1 ;;
  esac
  if [[ "$requested" != auto ]]; then
    if ! engine_healthy "$requested"; then
      echo "Selected engine '$requested' is unavailable or unhealthy." >&2
      return 1
    fi
    printf '%s\n' "$requested"
    return 0
  fi
  for candidate in docker podman; do
    if engine_healthy "$candidate"; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  echo "No healthy container engine is available. Install Docker or Podman and start its service." >&2
  return 1
}

has_subordinate_range() {
  local path="$1" user="$2" uid="$3"
  awk -F: -v user="$user" -v uid="$uid" '
    ($1 == user || $1 == uid) && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && $2 > 0 && $3 > 0 { count += $3 }
    END { exit !(count >= 65536) }
  ' "$path" 2>/dev/null
}

assert_rootless_podman_prerequisites() {
  [[ "$ENGINE_COMMAND" == "podman" && "$(uname -s)" == "Linux" ]] || return 0

  local rootless user uid
  rootless="$(engine info --format '{{.Host.Security.Rootless}}' 2>/dev/null)" || {
    echo "Could not inspect the selected Podman engine. Run 'podman info' and repair its reported error." >&2
    return 1
  }
  if [[ "$rootless" != "true" ]]; then
    echo "Podman on Linux must report rootless=true; received '$rootless'." >&2
    echo "Run this launcher as your regular Linux user with a working rootless 'podman info'." >&2
    return 1
  fi

  user="$(id -un)"
  uid="$(id -u)"
  if ! has_subordinate_range /etc/subuid "$user" "$uid"; then
    echo "Rootless Podman requires at least 65536 subordinate UIDs for '$user' in /etc/subuid." >&2
    echo "Ask an administrator to assign an unused range, then log out and back in." >&2
    return 1
  fi
  if ! has_subordinate_range /etc/subgid "$user" "$uid"; then
    echo "Rootless Podman requires at least 65536 subordinate GIDs for '$user' in /etc/subgid." >&2
    echo "Ask an administrator to assign an unused range, then log out and back in." >&2
    return 1
  fi

  PODMAN_SELINUX_ENABLED="$(engine info --format '{{.Host.Security.SELinuxEnabled}}' 2>/dev/null)" || {
    echo "Could not detect SELinux support from the selected Podman engine." >&2
    return 1
  }
  case "$PODMAN_SELINUX_ENABLED" in
    true|false) ;;
    *) echo "Podman returned an unknown SELinux state: $PODMAN_SELINUX_ENABLED" >&2; return 1 ;;
  esac
}

workspace_meta() {
  local workspace="$1"
  local full_path
  full_path="$(cd "$workspace" && pwd)"
  local leaf slug hash suffix container_workspace_path
  leaf="$(basename "$full_path")"
  slug="$(printf '%s' "$leaf" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
  [[ -n "$slug" ]] || slug="workspace"
  hash="$(printf '%s' "${full_path,,}" | sha256sum | awk '{print $1}')"
  suffix="${hash:0:12}"
  local loopback_octet_2 loopback_octet_3 loopback_octet_4 host_address
  loopback_octet_2=$((64 + (16#${hash:0:2} % 64)))
  loopback_octet_3=$((16#${hash:2:2}))
  loopback_octet_4=$((1 + (16#${hash:4:2} % 254)))
  host_address="127.${loopback_octet_2}.${loopback_octet_3}.${loopback_octet_4}"
  container_workspace_path="/workspace/$slug"
  printf '%s\n' "$full_path" "$slug" "$suffix" "$container_workspace_path" "ai-sandbox-$slug-$suffix" \
    "ai-sandbox-$slug-$suffix-config" "ai-sandbox-$slug-$suffix-auth" \
    "ai-sandbox-$slug-$suffix-data" "ai-sandbox-$slug-$suffix-cache" "$host_address"
}

container_exists() {
  local expected="$(normalize_container_name "$1")"
  local found name
  found="$(engine ps -a --format '{{.Names}}' 2>/dev/null)" || return 2
  while IFS= read -r name; do
    [[ "$(normalize_container_name "$name")" == "$expected" ]] && return 0
  done <<<"$found"
  return 1
}

container_running() {
  local expected="$(normalize_container_name "$1")"
  local found name
  found="$(engine ps --format '{{.Names}}' 2>/dev/null || true)"
  while IFS= read -r name; do
    [[ "$(normalize_container_name "$name")" == "$expected" ]] && return 0
  done <<<"$found"
  return 1
}

image_id() {
  local value
  value="$(engine image inspect --format '{{.Id}}' "$1" 2>/dev/null)" || return 0
  printf '%s\n' "${value#sha256:}"
}

container_image_id() {
  local value
  value="$(engine inspect --format '{{.Image}}' "$1" 2>/dev/null)" || return 0
  printf '%s\n' "${value#sha256:}"
}

container_supplemental_signature() {
  local labels
  labels="$(engine inspect --format '{{ json .Config.Labels }}' "$1" 2>/dev/null)" || return 0
  # The signature is generated as hexadecimal text, so JSON escaping is not needed.
  local signature_pattern='"ai-sandbox\.supplemental-folders"[[:space:]]*:[[:space:]]*"([a-fA-F0-9]+)"'
  if [[ "$labels" =~ ^[[:space:]]*\{.*\}[[:space:]]*$ && "$labels" =~ $signature_pattern ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  fi
  return 0
}

ensure_volume() {
  local name="$1"
  engine volume inspect "$name" >/dev/null 2>&1 || engine volume create "$name" >/dev/null
}

build_image() {
  local pull_option=--pull
  [[ "$ENGINE_COMMAND" != podman ]] || pull_option=--pull=always
  local build_args=(build "$pull_option" -t "$IMAGE_TAG")
  if [[ "${UPDATE:-false}" == "true" || "${REBUILD:-false}" == "true" ]]; then
    build_args+=(--no-cache)
  fi
  engine "${build_args[@]}" "$REPO_ROOT"
}

remove_container() {
  local name="$1"
  if container_exists "$name"; then
    engine rm -f "$name" >/dev/null
  else
    local status=$?
    [[ "$status" == 1 ]] || return "$status"
  fi
}

remove_volume() {
  local name="$1" found existing
  found="$(engine volume ls --format '{{.Name}}')" || return $?
  while IFS= read -r existing; do
    if [[ "$existing" == "$name" ]]; then
      engine volume rm "$name" >/dev/null
      return $?
    fi
  done <<<"$found"
}

existing_host_port() {
  local name="$1"
  local container_port="$2"
  local output line
  output="$(engine port "$name" "${container_port}/tcp" 2>/dev/null)" || return 0
  while IFS= read -r line; do
    if [[ "$line" =~ :([0-9]+)[[:space:]]*$ ]]; then
      printf '%s\n' "${BASH_REMATCH[1]}"
      return 0
    fi
  done <<<"$output"
  return 0
}

container_port_mappings() {
  # HostConfig retains configured bindings when a stopped container has no live ports.
  engine inspect --format '{{range $port, $bindings := .HostConfig.PortBindings}}{{range $bindings}}{{printf "%s %s %s\n" $port .HostIp .HostPort}}{{end}}{{end}}' "$1" 2>/dev/null
}

container_folder_name_valid() {
  local name="$1"
  [[ -n "$name" ]] || return 1
  [[ "$name" == "${name#"${name%%[![:space:]]*}"}" ]] || return 1
  [[ "$name" == "${name%"${name##*[![:space:]]}"}" ]] || return 1
  [[ "$name" != *"/"* && "$name" != *"\\"* && "$name" != *":"* && "$name" != *"*"* &&
    "$name" != *"?"* && "$name" != *"\""* && "$name" != *"<"* && "$name" != *">"* &&
    "$name" != *"|"* ]]
}

split_supplemental_folder_line() {
  local line="$1"
  local path="$2"
  local line_number="$3"
  [[ -n "${line//[[:space:]]/}" ]] || return 1
  local trimmed="${line#"${line%%[![:space:]]*}"}"
  [[ "$trimmed" != \#* ]] || return 1

  local mode="ro"
  local without_mode="$line"
  if [[ "$line" == *"|"* ]]; then
    local candidate_mode="${line##*|}"
    if [[ "$candidate_mode" == "ro" || "$candidate_mode" == "rw" ]]; then
      mode="$candidate_mode"
      without_mode="${line%|*}"
    fi
  fi

  if [[ "$without_mode" != *"|"* ]]; then
    echo "Invalid supplemental folder entry in ${path}:${line_number}. Expected host_path|container_name|mode." >&2
    exit 1
  fi

  local host_path="${without_mode%|*}"
  local name="${without_mode##*|}"
  if ! container_folder_name_valid "$name"; then
    echo "Invalid supplemental folder target '${name}' in ${path}:${line_number}. It must be one path segment and cannot contain / \\ : * ? \" < > |." >&2
    exit 1
  fi

  if [[ "$mode" != "ro" && "$mode" != "rw" ]]; then
    echo "Invalid supplemental folder mode '${mode}' in ${path}:${line_number}. Expected ro or rw." >&2
    exit 1
  fi

  SPLIT_HOST_PATH="$(cd "$host_path" 2>/dev/null && pwd || true)"
  if [[ -z "$SPLIT_HOST_PATH" || ! -d "$SPLIT_HOST_PATH" ]]; then
    echo "Supplemental folder path from config does not exist or is not a directory: ${host_path}" >&2
    exit 1
  fi
  SPLIT_CONTAINER_NAME="$name"
  SPLIT_MODE="$mode"
}

read_supplemental_folder_config() {
  local path="$1"
  local scope="$2"
  local -n out_hosts="$3"
  local -n out_names="$4"
  local -n out_modes="$5"
  [[ -f "$path" ]] || return 0

  declare -A seen=()
  local line line_number=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line_number=$((line_number + 1))
    if split_supplemental_folder_line "$line" "$path" "$line_number"; then
      if [[ -n "${seen[$SPLIT_CONTAINER_NAME]:-}" ]]; then
        echo "Duplicate supplemental folder target /supplemental/${SPLIT_CONTAINER_NAME} in ${scope} config: ${path}" >&2
        exit 1
      fi
      seen["$SPLIT_CONTAINER_NAME"]="true"
      out_hosts+=("$SPLIT_HOST_PATH")
      out_names+=("$SPLIT_CONTAINER_NAME")
      out_modes+=("$SPLIT_MODE")
    fi
  done <"$path"
}

supplemental_mount_args() {
  SUPPLEMENTAL_MOUNT_ARGS=()
  SUPPLEMENTAL_WARNINGS=()
  local global_path="${HOME}/.ai-sandbox/supplemental-folders.config"
  local local_path="${WORKSPACE_PATH}/.ai-sandbox/supplemental-folders.config"
  local global_hosts=() global_names=() global_modes=()
  local local_hosts=() local_names=() local_modes=()
  read_supplemental_folder_config "$global_path" "global" global_hosts global_names global_modes
  read_supplemental_folder_config "$local_path" "local" local_hosts local_names local_modes

  declare -A host_by_name=()
  declare -A mode_by_name=()
  local names=()
  local i
  for i in "${!global_names[@]}"; do
    names+=("${global_names[$i]}")
    host_by_name["${global_names[$i]}"]="${global_hosts[$i]}"
    mode_by_name["${global_names[$i]}"]="${global_modes[$i]}"
  done

  for i in "${!local_names[@]}"; do
    local name="${local_names[$i]}"
    if [[ -n "${host_by_name[$name]:-}" ]]; then
      SUPPLEMENTAL_WARNINGS+=("local supplemental folder overrides global mapping for /supplemental/${name}: using ${local_hosts[$i]}, ignoring ${host_by_name[$name]}")
    else
      names+=("$name")
    fi
    host_by_name["$name"]="${local_hosts[$i]}"
    mode_by_name["$name"]="${local_modes[$i]}"
  done

  local signature_text=""
  if [[ "$ENGINE_COMMAND" == podman ]]; then
    signature_text="podman-rootless-keep-id-v1|selinux=${PODMAN_SELINUX_ENABLED:-false}"$'\n'
  fi
  local sorted_names
  sorted_names="$(printf '%s\n' "${names[@]}" | sort)"
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    local mount_options="${mode_by_name[$name]}"
    if [[ "${PODMAN_SELINUX_ENABLED:-false}" == "true" ]]; then
      mount_options+=",z"
    fi
    SUPPLEMENTAL_MOUNT_ARGS+=("-v" "${host_by_name[$name]}:/supplemental/${name}:${mount_options}")
    signature_text+="${host_by_name[$name]}|${name}|${mode_by_name[$name]}"$'\n'
  done <<<"$sorted_names"
  SUPPLEMENTAL_SIGNATURE="$(printf '%s' "$signature_text" | sha256sum | awk '{print $1}')"
}

print_supplemental_warnings() {
  ((${#SUPPLEMENTAL_WARNINGS[@]} == 0)) && return 0
  local warning
  for warning in "${SUPPLEMENTAL_WARNINGS[@]}"; do
    if [[ -t 2 ]]; then
      printf '\033[33mWarning: %s\033[0m\n' "$warning" >&2
    else
      printf 'Warning: %s\n' "$warning" >&2
    fi
  done
}

ensure_container() {
  local current_image_id
  current_image_id="$(image_id "$IMAGE_TAG")"
  [[ -n "$current_image_id" ]] || { echo "Image $IMAGE_TAG not found." >&2; exit 1; }

  if container_exists "$CONTAINER_NAME"; then
    local running_image_id
    local running_supplemental_signature
    local recreate_needed="false"
    running_image_id="$(container_image_id "$CONTAINER_NAME")"
    running_supplemental_signature="$(container_supplemental_signature "$CONTAINER_NAME")"
    if [[ "$FORCE_RECREATE" == "true" || "${running_image_id#sha256:}" != "${current_image_id#sha256:}" || "$running_supplemental_signature" != "$SUPPLEMENTAL_SIGNATURE" ]]; then
      recreate_needed="true"
    fi
    local container_port mapping endpoint matched
    mapping="$(container_port_mappings "$CONTAINER_NAME" || true)"
    for container_port in "$DEFAULT_T3_CONTAINER_PORT" "$DEFAULT_CODENOMAD_CONTAINER_PORT" "$DEFAULT_PASEO_CONTAINER_PORT" "$DEFAULT_ALT_HTTP_CONTAINER_PORT" "$DEFAULT_APP_CONTAINER_PORT"; do
      matched=false
      while IFS= read -r endpoint; do
        [[ "$endpoint" != "${container_port}/tcp ${HOST_ADDRESS} ${container_port}" ]] || matched=true
      done <<<"$mapping"
      [[ "$matched" == true ]] || recreate_needed="true"
    done
    if [[ "$recreate_needed" == "true" ]]; then
      remove_container "$CONTAINER_NAME"
    fi
  fi

  ensure_volume "$CONFIG_VOLUME"
  ensure_volume "$AUTH_VOLUME"
  ensure_volume "$DATA_VOLUME"
  ensure_volume "$CACHE_VOLUME"

  if ! container_exists "$CONTAINER_NAME"; then
    local workspace_mount="${WORKSPACE_PATH}:${CONTAINER_WORKSPACE_PATH}"
    local namespace_args=()
    if [[ "$ENGINE_COMMAND" == podman ]]; then
      # Keep host-owned paths writable by sandbox while root initializes users and state.
      namespace_args=(--userns=keep-id --user 0)
    fi
    if [[ "${PODMAN_SELINUX_ENABLED:-false}" == "true" ]]; then
      workspace_mount+=":Z"
    fi
    engine run -d \
      "${namespace_args[@]}" \
      --name "$CONTAINER_NAME" \
      --hostname "${WORKSPACE_SLUG:0:50}-${WORKSPACE_HASH}" \
      --label "ai-sandbox.workspace=${WORKSPACE_PATH}" \
      --label "ai-sandbox.hash=${WORKSPACE_HASH}" \
      --label "ai-sandbox.supplemental-folders=${SUPPLEMENTAL_SIGNATURE}" \
      -p "${HOST_ADDRESS}:${DEFAULT_T3_CONTAINER_PORT}:${DEFAULT_T3_CONTAINER_PORT}" \
      -p "${HOST_ADDRESS}:${DEFAULT_CODENOMAD_CONTAINER_PORT}:${DEFAULT_CODENOMAD_CONTAINER_PORT}" \
      -p "${HOST_ADDRESS}:${DEFAULT_PASEO_CONTAINER_PORT}:${DEFAULT_PASEO_CONTAINER_PORT}" \
      -p "${HOST_ADDRESS}:${DEFAULT_ALT_HTTP_CONTAINER_PORT}:${DEFAULT_ALT_HTTP_CONTAINER_PORT}" \
      -p "${HOST_ADDRESS}:${DEFAULT_APP_CONTAINER_PORT}:${DEFAULT_APP_CONTAINER_PORT}" \
      -e "AI_SANDBOX_T3_PORT=${DEFAULT_T3_CONTAINER_PORT}" \
      -e "AI_SANDBOX_HOST_T3_PORT=${DEFAULT_T3_CONTAINER_PORT}" \
      -e "AI_SANDBOX_T3_URL=http://${HOST_ADDRESS}:${DEFAULT_T3_CONTAINER_PORT}" \
      -e "AI_SANDBOX_CODENOMAD_PORT=${DEFAULT_CODENOMAD_CONTAINER_PORT}" \
      -e "AI_SANDBOX_HOST_CODENOMAD_PORT=${DEFAULT_CODENOMAD_CONTAINER_PORT}" \
      -e "AI_SANDBOX_CODENOMAD_URL=http://${HOST_ADDRESS}:${DEFAULT_CODENOMAD_CONTAINER_PORT}" \
      -e "AI_SANDBOX_PASEO_PORT=${DEFAULT_PASEO_CONTAINER_PORT}" \
      -e "AI_SANDBOX_HOST_PASEO_PORT=${DEFAULT_PASEO_CONTAINER_PORT}" \
      -e "AI_SANDBOX_PASEO_ADDRESS=${HOST_ADDRESS}:${DEFAULT_PASEO_CONTAINER_PORT}" \
      -e "AI_SANDBOX_ALT_HTTP_PORT=${DEFAULT_ALT_HTTP_CONTAINER_PORT}" \
      -e "AI_SANDBOX_HOST_ALT_HTTP_PORT=${DEFAULT_ALT_HTTP_CONTAINER_PORT}" \
      -e "AI_SANDBOX_ALT_HTTP_URL=http://${HOST_ADDRESS}:${DEFAULT_ALT_HTTP_CONTAINER_PORT}" \
      -e "AI_SANDBOX_APP_PORT=${DEFAULT_APP_CONTAINER_PORT}" \
      -e "AI_SANDBOX_HOST_APP_PORT=${DEFAULT_APP_CONTAINER_PORT}" \
      -e "AI_SANDBOX_APP_URL=http://${HOST_ADDRESS}:${DEFAULT_APP_CONTAINER_PORT}" \
      -e "AI_SANDBOX_WORKSPACE_PATH=${CONTAINER_WORKSPACE_PATH}" \
      -e "LOCAL_UID=$(id -u)" \
      -e "LOCAL_GID=$(id -g)" \
      -v "$workspace_mount" \
      -v "${CONFIG_VOLUME}:/state/config" \
      -v "${AUTH_VOLUME}:/state/auth" \
      -v "${DATA_VOLUME}:/state/data" \
      -v "${CACHE_VOLUME}:/state/cache" \
      "${SUPPLEMENTAL_MOUNT_ARGS[@]}" \
      "$IMAGE_TAG" \
      daemon >/dev/null
  elif ! container_running "$CONTAINER_NAME"; then
    engine start "$CONTAINER_NAME" >/dev/null
  fi
}

exec_in_container() {
  local interactive="$1"
  shift
  if [[ "$interactive" == "true" ]]; then
    engine exec -it \
      -e "AI_SANDBOX_T3_URL=http://${HOST_ADDRESS}:${DEFAULT_T3_CONTAINER_PORT}" \
      -e "AI_SANDBOX_HOST_T3_PORT=${DEFAULT_T3_CONTAINER_PORT}" \
      -e "AI_SANDBOX_T3_PORT=${DEFAULT_T3_CONTAINER_PORT}" \
      -e "AI_SANDBOX_CODENOMAD_URL=http://${HOST_ADDRESS}:${DEFAULT_CODENOMAD_CONTAINER_PORT}" \
      -e "AI_SANDBOX_HOST_CODENOMAD_PORT=${DEFAULT_CODENOMAD_CONTAINER_PORT}" \
      -e "AI_SANDBOX_CODENOMAD_PORT=${DEFAULT_CODENOMAD_CONTAINER_PORT}" \
      -e "AI_SANDBOX_PASEO_ADDRESS=${HOST_ADDRESS}:${DEFAULT_PASEO_CONTAINER_PORT}" \
      -e "AI_SANDBOX_HOST_PASEO_PORT=${DEFAULT_PASEO_CONTAINER_PORT}" \
      -e "AI_SANDBOX_PASEO_PORT=${DEFAULT_PASEO_CONTAINER_PORT}" \
      -e "AI_SANDBOX_ALT_HTTP_URL=http://${HOST_ADDRESS}:${DEFAULT_ALT_HTTP_CONTAINER_PORT}" \
      -e "AI_SANDBOX_HOST_ALT_HTTP_PORT=${DEFAULT_ALT_HTTP_CONTAINER_PORT}" \
      -e "AI_SANDBOX_ALT_HTTP_PORT=${DEFAULT_ALT_HTTP_CONTAINER_PORT}" \
      -e "AI_SANDBOX_APP_URL=http://${HOST_ADDRESS}:${DEFAULT_APP_CONTAINER_PORT}" \
      -e "AI_SANDBOX_HOST_APP_PORT=${DEFAULT_APP_CONTAINER_PORT}" \
      -e "AI_SANDBOX_APP_PORT=${DEFAULT_APP_CONTAINER_PORT}" \
      -e "AI_SANDBOX_WORKSPACE_PATH=${CONTAINER_WORKSPACE_PATH}" \
      "$CONTAINER_NAME" \
      /opt/ai-sandbox/entrypoint.sh "$@"
  else
    engine exec \
      -e "AI_SANDBOX_T3_URL=http://${HOST_ADDRESS}:${DEFAULT_T3_CONTAINER_PORT}" \
      -e "AI_SANDBOX_HOST_T3_PORT=${DEFAULT_T3_CONTAINER_PORT}" \
      -e "AI_SANDBOX_T3_PORT=${DEFAULT_T3_CONTAINER_PORT}" \
      -e "AI_SANDBOX_CODENOMAD_URL=http://${HOST_ADDRESS}:${DEFAULT_CODENOMAD_CONTAINER_PORT}" \
      -e "AI_SANDBOX_HOST_CODENOMAD_PORT=${DEFAULT_CODENOMAD_CONTAINER_PORT}" \
      -e "AI_SANDBOX_CODENOMAD_PORT=${DEFAULT_CODENOMAD_CONTAINER_PORT}" \
      -e "AI_SANDBOX_PASEO_ADDRESS=${HOST_ADDRESS}:${DEFAULT_PASEO_CONTAINER_PORT}" \
      -e "AI_SANDBOX_HOST_PASEO_PORT=${DEFAULT_PASEO_CONTAINER_PORT}" \
      -e "AI_SANDBOX_PASEO_PORT=${DEFAULT_PASEO_CONTAINER_PORT}" \
      -e "AI_SANDBOX_ALT_HTTP_URL=http://${HOST_ADDRESS}:${DEFAULT_ALT_HTTP_CONTAINER_PORT}" \
      -e "AI_SANDBOX_HOST_ALT_HTTP_PORT=${DEFAULT_ALT_HTTP_CONTAINER_PORT}" \
      -e "AI_SANDBOX_ALT_HTTP_PORT=${DEFAULT_ALT_HTTP_CONTAINER_PORT}" \
      -e "AI_SANDBOX_APP_URL=http://${HOST_ADDRESS}:${DEFAULT_APP_CONTAINER_PORT}" \
      -e "AI_SANDBOX_HOST_APP_PORT=${DEFAULT_APP_CONTAINER_PORT}" \
      -e "AI_SANDBOX_APP_PORT=${DEFAULT_APP_CONTAINER_PORT}" \
      -e "AI_SANDBOX_WORKSPACE_PATH=${CONTAINER_WORKSPACE_PATH}" \
      "$CONTAINER_NAME" \
      /opt/ai-sandbox/entrypoint.sh "$@"
  fi
}

UPDATE="false"
REBUILD="false"
FORCE_RECREATE="false"
REQUESTED_ENGINE="${AI_SANDBOX_ENGINE:-auto}"
[[ -n "${REQUESTED_ENGINE//[[:space:]]/}" ]] || REQUESTED_ENGINE="auto"
POSITIONALS=()
ADD_FOLDER_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help)
      usage
      exit 0
      ;;
    --update)
      UPDATE="true"
      shift
      ;;
    --rebuild)
      REBUILD="true"
      FORCE_RECREATE="true"
      shift
      ;;
    --engine)
      shift
      [[ $# -gt 0 ]] || { echo "Missing engine for --engine. Expected auto, docker, or podman." >&2; exit 1; }
      REQUESTED_ENGINE="$1"
      shift
      ;;
    --add-folder)
      shift
      [[ $# -gt 0 ]] || { echo "Missing folder path for --add-folder." >&2; exit 1; }
      ADD_FOLDER_ARGS=("$@")
      break
      ;;
    --*)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
    *)
      # After the command, every argument belongs to the in-container tool.
      POSITIONALS+=("$@")
      break
      ;;
    esac
done

if [[ ${#ADD_FOLDER_ARGS[@]} -gt 0 ]]; then
  bash "${REPO_ROOT}/scripts/add-supplemental-folder.sh" "${ADD_FOLDER_ARGS[@]}"
  exit $?
fi

COMMAND="${POSITIONALS[0]:-shell}"
COMMAND_ARGS=("${POSITIONALS[@]:1}")

ENGINE_COMMAND="$(resolve_engine "$REQUESTED_ENGINE")"
PODMAN_SELINUX_ENABLED="false"
assert_rootless_podman_prerequisites
mapfile -t META < <(workspace_meta "$PWD")
WORKSPACE_PATH="${META[0]}"
WORKSPACE_SLUG="${META[1]}"
WORKSPACE_HASH="${META[2]}"
CONTAINER_WORKSPACE_PATH="${META[3]}"
CONTAINER_NAME="${META[4]}"
CONFIG_VOLUME="${META[5]}"
AUTH_VOLUME="${META[6]}"
DATA_VOLUME="${META[7]}"
CACHE_VOLUME="${META[8]}"
HOST_ADDRESS="${META[9]}"

supplemental_mount_args

if [[ -z "$(image_id "$IMAGE_TAG")" || "$UPDATE" == "true" || "$REBUILD" == "true" ]]; then
  build_image
fi

case "$COMMAND" in
  stop)
    if container_exists "$CONTAINER_NAME"; then
      engine stop "$CONTAINER_NAME" >/dev/null
    else
      status=$?
      [[ "$status" == 1 ]] || exit "$status"
    fi
    exit 0
    ;;
  rm)
    remove_container "$CONTAINER_NAME"
    exit 0
    ;;
  reset-state)
    remove_container "$CONTAINER_NAME"
    for volume in "$CONFIG_VOLUME" "$AUTH_VOLUME" "$DATA_VOLUME" "$CACHE_VOLUME"; do
      remove_volume "$volume"
    done
    exit 0
    ;;
esac

if [[ "$REBUILD" == "true" ]]; then
  remove_container "$CONTAINER_NAME"
fi

ensure_container
print_supplemental_warnings

case "$COMMAND" in
  reset-config)
    exec_in_container false reset-config
    ;;
  doctor)
    exec_in_container false doctor
    ;;
  t3|codenomad|paseo)
    exec_in_container false "$COMMAND" "${COMMAND_ARGS[@]}"
    ;;
  shell)
    exec_in_container true shell
    ;;
  *)
    exec_in_container true "$COMMAND" "${COMMAND_ARGS[@]}"
    ;;
esac
